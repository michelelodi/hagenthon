# Token del bot Telegram (ottenuto da @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta del server locale (la webapp legge da qui)
PORT=3001

# Gli scontrini si leggono con Claude via tools/askclaude/ (CLI `claude` locale):
# NESSUNA API key — serve solo `claude` installato e loggato.
# (Opzionale) se `claude` non è nel PATH:
# ASKCLAUDE_CLAUDE_BIN=/percorso/di/claude
# (Opzionale) demo offline con risposte registrate:
# ASKCLAUDE_CLAUDE_BIN=../tools/askclaude/test/stub-bin.mjs
